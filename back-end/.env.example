# Copie este arquivo para ".env" e preencha. Nunca faça commit do .env.
# O servidor não sobe se faltar alguma variável obrigatória.

# Login do painel da loja (atendente)
PAINEL_USUARIO=email@exemplo.com
PAINEL_SENHA=troque-esta-senha

# Login do dashboard (faturamento e vendas): só o gerente
GERENTE_USUARIO=gerente@exemplo.com
GERENTE_SENHA=troque-esta-senha

# Segredo para assinar os tokens de login (mínimo 32 caracteres aleatórios)
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Sites que podem chamar a API, separados por vírgula (obrigatório em produção).
# Em desenvolvimento pode ficar vazio: libera tudo para testar pelo celular na rede local.
# Ex.: https://macaco-grelhado-cardapio.vercel.app,https://macaco-grelhado-painel.vercel.app
CORS_ORIGINS=

# "production" no servidor publicado (cadastre no Render). Em desenvolvimento, deixe vazio.
NODE_ENV=

# Porta da API (o Render define sozinho)
PORT=4002
