# Copie este arquivo para ".env" e preencha. Nunca faça commit do .env.

# Login do painel da loja (prévia: um usuário só)
PAINEL_USUARIO=email@exemplo.com
PAINEL_SENHA=troque-esta-senha

# Login do dashboard (faturamento e vendas): só o gerente
GERENTE_USUARIO=gerente@exemplo.com
GERENTE_SENHA=troque-esta-senha

# Segredo para assinar os tokens do painel (mínimo 32 caracteres aleatórios)
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Porta da API
PORT=4002
